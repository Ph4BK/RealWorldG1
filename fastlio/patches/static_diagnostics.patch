+void g1_cloud(const std::string &stage, const PointCloudXYZI &cloud) {
+  if (!g1_diag_dir || cloud.empty()) return;
+  pcl::io::savePCDFileBinary(std::string(g1_diag_dir)+"/"+stage+"_"+std::to_string(scan_count)+".pcd", cloud);
+}
+void g1_state(const std::string &stage) {
+  if (!g1_diag_dir) return;
+  std::ofstream f(std::string(g1_diag_dir)+"/states.csv",std::ios::app);
+  f << std::setprecision(17) << stage << "," << scan_count << "," << Measures.lidar_beg_time;
+  auto s=kf.get_x();
+  for (auto v : {s.pos[0],s.pos[1],s.pos[2],s.vel[0],s.vel[1],s.vel[2],s.rot.x(),s.rot.y(),s.rot.z(),s.rot.w()}) f << "," << v;
+  f << "\n";
+}
