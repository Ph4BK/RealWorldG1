+// Unitree PointCloud2: x/y/z/intensity float32, ring uint16, time float32.
+// time is offset from the message header; timestamp_unit controls units.
+void Preprocess::unitree_mid360_handler(const sensor_msgs::msg::PointCloud2::UniquePtr &msg)
+{
+  for (const auto &name : {"x", "y", "z", "intensity", "ring", "time"}) {
+    const auto it = std::find_if(msg->fields.begin(), msg->fields.end(),
+      [&](const auto &f) { return f.name == name; });
+    const auto expected = std::string(name) == "ring" ? sensor_msgs::msg::PointField::UINT16 : sensor_msgs::msg::PointField::FLOAT32;
+    if (it == msg->fields.end() || it->datatype != expected || it->count != 1)
+      throw std::runtime_error(std::string("Invalid Unitree PointCloud2 field: ") + name);
+  }
+  pcl::PointCloud<velodyne_ros::Point> cloud;
+  pcl::fromROSMsg(*msg, cloud);
+  pl_surf.clear(); pl_corn.clear(); pl_full.clear();
+  pl_surf.reserve(cloud.size());
+  given_offset_time = true;
+  const int stride = std::max(1, point_filter_num);
+  for (size_t i = 0; i < cloud.size(); i += stride) {
+    const auto &p = cloud[i];
+    if (!std::isfinite(p.x) || !std::isfinite(p.y) || !std::isfinite(p.z) ||
+        !std::isfinite(p.time) || p.time < 0 || p.ring >= N_SCANS) continue;
+    if (p.x*p.x + p.y*p.y + p.z*p.z <= blind*blind) continue;
+    PointType q;
+    q.x=p.x; q.y=p.y; q.z=p.z; q.intensity=p.intensity;
+    q.normal_x=q.normal_y=q.normal_z=0;
+    q.curvature=p.time*time_unit_scale; // FAST-LIO stores offsets in milliseconds.
+    pl_surf.push_back(q);
+  }
+  std::sort(pl_surf.begin(), pl_surf.end(), [](const auto &a, const auto &b) { return a.curvature < b.curvature; });
+}
